# Application Environment (development, testing, production)
APP_ENV=development

# Authentication Token (Bearer token for API access)
# For local development demo purposes; change in your local .env
API_AUTH_TOKEN=dev-secret-token-12345

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration (SQLite zero-cost local database)
DATABASE_URL=sqlite:///./data/app.db

# Agent Guardrails & Limits
MAX_AGENT_STEPS=8
MAX_TOOL_RETRIES=2
RATE_LIMIT_PER_MINUTE=30

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Server Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000
